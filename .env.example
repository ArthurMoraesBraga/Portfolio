# Copie este arquivo para .env.local e nunca envie o .env.local ao Git.
# Estas variáveis ficam apenas no servidor. Não use o prefixo VITE_.

# Primeiro, preencha os dados do app criado em https://wakatime.com/apps.
WAKATIME_APP_ID=
WAKATIME_APP_SECRET=

# Depois, rode `npm run wakatime:oauth` e cole os tokens gerados.
WAKATIME_ACCESS_TOKEN=
WAKATIME_REFRESH_TOKEN=

# Opcional: projetos adicionais que podem aparecer pelo nome, separados por vírgula.
# O projeto Portfolio já está permitido em src/config/WakatimeConfig.js.
# WAKATIME_PUBLIC_PROJECTS=outro-projeto,projeto-publico
